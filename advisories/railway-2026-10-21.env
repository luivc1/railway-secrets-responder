# =====================================================================
#  Advisory file: single source of truth for the audit tool and skills.
#  Plain KEY="value" lines. For a future incident, copy this file, update
#  it from Railway's official posts, and pass --advisory <file>.
# =====================================================================

ADVISORY_ID="railway-2026-10-21"
ADVISORY_NAME="Railway security disclosure, October 21 2026"
DISCLOSED="2026-10-21"

SUMMARY="Railway detected anomalous activity in systems that store customer environment variables. An unauthorized third party may have accessed encrypted environment variables and, for some, their decrypted contents. Railway believes it is part of a wider campaign targeting platform companies to compromise AI inference providers."

# What Railway says to rotate (blog post, Oct 21 2026)
ROTATE_SCOPE="All environment variables stored in Railway (including API keys and database credentials) and private registry credentials."

# Railway: impact may be limited to a subset of users; confirmed affected
# accounts are contacted by email. All users are advised to take precautions.
WHO="All Railway users should rotate. Confirmed affected accounts get an email from Railway."

# No exposure window published yet. Default: treat every value that existed
# on or before the disclosure date as exposed.
EXPOSED_BEFORE="2026-10-21"

# Operational constraint at disclosure time
DEPLOY_NOTE="Railway paused builds/deployments during the investigation. New variable values only reach running services after a successful deploy, so plan rotations per secret (see the rsr-rotate skill)."

# Railway asked upstream providers to revoke keys proactively (providers not
# named). An AI key may already be revoked: check the provider console.
UPSTREAM_NOTE="Railway notified upstream providers to revoke keys proactively. Some keys (especially AI provider keys) may already be disabled; rotate anyway and confirm in each provider console."

# Reported by security press (not in Railway's post at the time of writing):
REPORTED_NOTE="Press reports say Railway is rotating Storage Bucket credentials itself; new values appear in the dashboard and need a redeploy."

PRIORITY_NOTE="AI provider keys are P1 because Railway links the incident to a campaign targeting AI inference providers."

SOURCES="https://blog.railway.com/p/security-disclosure-wednesday-october-21st | https://status.railway.com/incident/QH8L8B3E"
LAST_VERIFIED="2026-10-22"
